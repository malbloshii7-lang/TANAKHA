# ─── Image rendering ────────────────────────────────────────────────────────
# If IMAGE_PROVIDER is "mock" (or no key is set), the app uses the built-in
# offline renderer — the full flow works with zero keys. Switch to "replicate"
# and add a key for real photorealistic "after" images.
IMAGE_PROVIDER=mock
IMAGE_API_KEY=
REPLICATE_MODEL=black-forest-labs/flux-dev

# ─── Claude design brief ─────────────────────────────────────────────────────
# Used to analyze the photo and write the design brief. If unset/unreachable,
# the app falls back to a per-style templated brief automatically.
# ANTHROPIC_API_KEY and ANTHROPIC_BASE_URL are read by the SDK from the env.
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Set to 1 to skip Claude entirely and always use templated briefs.
TANAKHA_DISABLE_CLAUDE=

# ─── Storage ─────────────────────────────────────────────────────────────────
MEDIA_DIR=media
DATABASE_PATH=tanakha.db

# ─── Climate Pulse — live feed ingestion ────────────────────────────────────
# Comma-separated list of feed sources to poll. "mock" is a zero-key offline
# generator (always works, no network). "rss" polls real, free, keyless
# public feeds (NWS alerts, USGS earthquakes, ReliefWeb, GDACS). "twitter"
# polls the real X API v2 recent-search endpoint but only activates if
# X_BEARER_TOKEN is set (requires a paid X API tier).
CLIMATE_SOURCES=mock
CLIMATE_EVENT_SOURCES=mock
X_BEARER_TOKEN=
# Set to 0 to disable all background polling (used by the test suite).
CLIMATE_INGESTION_ENABLED=1
